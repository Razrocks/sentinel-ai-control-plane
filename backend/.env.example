DATABASE_URL="postgresql://sentinel:sentinel_dev@localhost:5432/sentinel"
PORT=3001
JWT_SECRET="change-this-in-production"
ANTHROPIC_API_KEY=""

# AES-256-GCM key for integration credential storage (32 raw bytes, base64-encoded).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Optional — enables LangSmith tracing for the one skill that runs
# through the LangChain runtime (explain_policy_decision) and for the
# RAG doc retrieval calls. Off by default; no LangSmith account needed
# to run Sentinel locally.
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="sentinel"
LANGSMITH_TRACING="false"
