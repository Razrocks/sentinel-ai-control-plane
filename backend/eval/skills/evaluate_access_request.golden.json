        { "kind": "field_in", "path": "riskLevel", "value": ["low", "medium"], "label": "familiar read → low or medium" },
        { "kind": "field_in", "path": "justificationQuality", "value": ["adequate", "strong"], "label": "specific scope → adequate or strong" }
      ]
    }
  ]
}
