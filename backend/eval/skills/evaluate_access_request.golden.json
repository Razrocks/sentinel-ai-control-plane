      "input": {
        "request": {
          "id": "ar-eval-2",
          "requestId": "AR-EVAL-002",
          "requester": "R. Singh",
          "requesterEmail": "r.singh@sentinel.dev",
          "requestedSystem": "search-service",
          "requestedRole": "read",
          "justification": "Investigating a search relevance bug reported by support. Need to read search-service logs and config to reproduce. Scope: search relevance pipeline only.",
          "manager": "T. Anderson",
          "systemOwner": "T. Anderson",
          "riskLevel": "low",
          "entitlementCheck": "eligible"
        },
        "requesterContext": {
          "role": "engineer",
          "team": "Search",
          "managerId": "usr-tanderson",
          "systemsOwned": ["search-service"],
          "pastRequests": [
            { "requestId": "AR-2025-330", "system": "search-service", "role": "read", "status": "approved", "resolvedAt": "2025-12-01T10:00:00Z" }
          ]
        },
        "systemContext": {
          "catalogTier": "medium",
          "rolePrivilegeLevel": "read",
          "activeFreezeAffectingSystem": false
