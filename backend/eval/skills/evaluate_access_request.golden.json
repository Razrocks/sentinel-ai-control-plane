{
  "skill": "evaluate_access_request",
  "samples": [
    {
      "name": "first_time_admin_access",
      "description": "Engineer requests admin on critical system for first time → high risk, time-bound recommended",
      "input": {
        "request": {
          "id": "ar-eval-1",
          "requestId": "AR-EVAL-001",
          "requester": "M. Liu",
          "requesterEmail": "m.liu@sentinel.dev",
          "requestedSystem": "customer-data-warehouse",
          "requestedRole": "admin",
          "justification": "Need admin to investigate Q2 reporting discrepancy.",
          "manager": "S. Park",
          "systemOwner": "C. Davies",
          "riskLevel": "medium",
          "entitlementCheck": "review_required"
        },
        "requesterContext": {
          "role": "engineer",
          "team": "Payments",
          "managerId": "usr-spark",
          "systemsOwned": ["payment-service"],
          "pastRequests": []
        },
        "systemContext": {
          "catalogTier": "high",
          "rolePrivilegeLevel": "admin",
          "activeFreezeAffectingSystem": false
        }
      },
      "expectations": [
        { "kind": "status_is", "value": "success" },
        { "kind": "field_in", "path": "riskLevel", "value": ["high", "critical"], "label": "first-time admin on high-tier → high+" },
        { "kind": "field_in", "path": "justificationQuality", "value": ["weak", "insufficient", "adequate"], "label": "thin justification → not strong" },
        { "kind": "field_length_min", "path": "flags", "value": 1, "label": "at least 1 flag (no prior history)" }
      ]
    },
    {
      "name": "read_access_familiar_system",
