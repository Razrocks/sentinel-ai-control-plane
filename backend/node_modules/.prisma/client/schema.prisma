generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum RiskLevel {
  critical
  high
  medium
  low
}

enum ApprovalState {
  approved
  pending
  denied
  not_required
}

enum PolicyDecision {
  allow
  deny
  escalate
  simulate_only
}

enum ConfidenceLevel {
  high
  medium
  low
}

enum ChangeStatus {
  open
  in_review
  approved
  blocked
  escalated
  deployed
  rolled_back
}

enum CIStatus {
  passing
  failing
  pending
}

enum IncidentSeverity {
  sev1
  sev2
  sev3
  sev4
}

enum IncidentStatus {
  new_incident
  investigating
  identified
  monitoring
  resolved
}

enum AccessRequestStatus {
  pending
  approved
  denied
  revoked
  expired
}

enum EntitlementCheck {
  eligible
  ineligible
  review_required
}

enum ApprovalType {
  change
  access
  remediation
  escalation
}

enum ApprovalStatus {
  pending
  approved
  denied
  approved_with_condition
}

enum CoApprovalStatus {
  approved
  pending
  denied
}

enum AuditObjectType {
  change
  incident
  access
  policy
  execution
  approval
}

enum AuditResult {
  success
  blocked
  escalated
  denied
}

enum RecommendationClass {
  required_now
  recommended
  optional_optimization
  out_of_scope
}

enum BlastRadiusType {
  service
  database
  api
  queue
  job
  monitoring
  integration
}

enum UserRole {
  operator
  engineer
  it_support
  approver
  access_approver
  admin
}

// ─── Models ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole
  team         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Change {
  id                String         @id @default(cuid())
  ticketId          String         @unique @map("ticket_id")
  title             String
  description       String
  owner             String
  ownerTeam         String         @map("owner_team")
  service           String
  environment       String
  riskLevel         RiskLevel      @map("risk_level")
  status            ChangeStatus
  approvalState     ApprovalState  @map("approval_state")
  policyDecision    PolicyDecision @map("policy_decision")
  linkedPRs         String[]       @map("linked_prs")
  ciStatus          CIStatus       @map("ci_status")
  maintenanceWindow String?        @map("maintenance_window")
  rollbackPlan      Boolean        @map("rollback_plan")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  blastRadius     BlastRadiusItem[]
  recommendations Recommendation[]
  auditEvents     AuditEvent[]      @relation("ChangeAuditEvents")

  @@index([status])
  @@index([riskLevel])
  @@index([service])
  @@map("changes")
}

model BlastRadiusItem {
  id          String          @id @default(cuid())
  changeId    String          @map("change_id")
  name        String
  type        BlastRadiusType
  reason      String
  confidence  ConfidenceLevel
  criticality RiskLevel
  ownerTeam   String          @map("owner_team")
  details     String

  change Change @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@index([changeId])
  @@map("blast_radius_items")
}

model Recommendation {
  id                String              @id @default(cuid())
  changeId          String              @map("change_id")
  title             String
  reason            String
  evidence          String
  classification    RecommendationClass
  expectedBenefit   String              @map("expected_benefit")
  requiredApprovals String[]            @map("required_approvals")
  executableNow     Boolean             @map("executable_now")
  draftOnly         Boolean             @map("draft_only")

  change Change @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@index([changeId])
  @@map("recommendations")
}

model Incident {
  id                String           @id @default(cuid())
  incidentId        String           @unique @map("incident_id")
  title             String
  description       String
  requester         String
  affectedService   String           @map("affected_service")
  severity          IncidentSeverity
  status            IncidentStatus
  assignmentGroup   String           @map("assignment_group")
  relatedCI         String[]         @map("related_ci")
  relatedChanges    String[]         @map("related_changes")
  likelyIssueType   String           @map("likely_issue_type")
  rootCauseCategory String           @map("root_cause_category")
  recommendedFix    String           @map("recommended_fix")
  kbArticles        String[]         @map("kb_articles")
  isRecurring       Boolean          @map("is_recurring")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([severity])
  @@index([status])
  @@map("incidents")
}

model AccessRequest {
  id                      String              @id @default(cuid())
  requestId               String              @unique @map("request_id")
  requester               String
  requesterEmail          String              @map("requester_email")
  requestedSystem         String              @map("requested_system")
  requestedRole           String              @map("requested_role")
  justification           String
  manager                 String
  systemOwner             String              @map("system_owner")
  status                  AccessRequestStatus
  riskLevel               RiskLevel           @map("risk_level")
  policyDecision          PolicyDecision      @map("policy_decision")
  entitlementCheck        EntitlementCheck    @map("entitlement_check")
  autoGrantAllowed        Boolean             @map("auto_grant_allowed")
  managerApprovalRequired Boolean             @map("manager_approval_required")
  ownerApprovalRequired   Boolean             @map("owner_approval_required")
  managerApproval         ApprovalState       @map("manager_approval")
  ownerApproval           ApprovalState       @map("owner_approval")
  reason                  String
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@index([riskLevel])
  @@map("access_requests")
}

model Approval {
  id                String         @id @default(cuid())
  type              ApprovalType
  title             String
  requester         String
  impactedSystem    String         @map("impacted_system")
  riskLevel         RiskLevel      @map("risk_level")
  reason            String
  recommendedAction String         @map("recommended_action")
  status            ApprovalStatus
  condition         String?
  createdAt         DateTime       @default(now()) @map("created_at")
  linkedObjectId    String         @map("linked_object_id")
  whyYouAreRequired String?        @map("why_you_are_required")

  coApprovals    CoApproval[]
  decisionImpact DecisionImpact?

  @@index([status])
  @@index([type])
  @@map("approvals")
}

model CoApproval {
  id         String           @id @default(cuid())
  approvalId String           @map("approval_id")
  role       String
  name       String
  status     CoApprovalStatus
  decidedAt  DateTime?        @map("decided_at")

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@map("co_approvals")
}

model DecisionImpact {
  id         String @id @default(cuid())
  approvalId String @unique @map("approval_id")
  approve    String
  deny       String
  escalate   String

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@map("decision_impacts")
}

model AuditEvent {
  id          String          @id @default(cuid())
  timestamp   DateTime        @default(now())
  actor       String
  action      String
  objectType  AuditObjectType @map("object_type")
  objectId    String          @map("object_id")
  objectTitle String          @map("object_title")
  policyRule  String?         @map("policy_rule")
  result      AuditResult
  details     String

  // Optional direct relation to change (for change-specific audit events)
  changeId String? @map("change_id")
  change   Change? @relation("ChangeAuditEvents", fields: [changeId], references: [id], onDelete: SetNull)

  @@index([objectType, objectId])
  @@index([timestamp(sort: Desc)])
  @@index([actor])
  @@map("audit_events")
}

model PolicyRule {
  id          String         @id @default(cuid())
  name        String         @unique
  description String
  bundle      String
  decision    PolicyDecision
  scope       String
  appliesTo   String[]       @map("applies_to")
  isActive    Boolean        @map("is_active")

  @@map("policy_rules")
}
