{
  "name": "sentinel-backend",
  "version": "1.0.0",
  "description": "Sentinel — policy-enforced operational control plane backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "secret-scan": "node ../scripts/secret-scan.mjs",
    "precommit": "node ../scripts/secret-scan.mjs --staged",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.6.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.6.0",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
