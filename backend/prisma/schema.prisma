generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum RiskLevel {
  critical
  high
  medium
  low
}

enum ApprovalState {
  approved
  pending
  denied
  not_required
}

enum PolicyDecision {
  allow
  deny
  escalate
  simulate_only
}

enum ConfidenceLevel {
  high
  medium
  low
}

enum ChangeStatus {
  open
  in_review
  approved
  blocked
  escalated
  deployed
  rolled_back
}

enum CIStatus {
  passing
  failing
  pending
}

enum IncidentSeverity {
  sev1
  sev2
  sev3
  sev4
}

enum IncidentStatus {
  new_incident
  investigating
  identified
  monitoring
  resolved
}

enum AccessRequestStatus {
  pending
  approved
  denied
  revoked
  expired
}

enum EntitlementCheck {
  eligible
  ineligible
  review_required
}

enum ApprovalType {
  change
  access
  remediation
  escalation
}

enum ApprovalStatus {
  pending
  approved
  denied
  approved_with_condition
}

enum CoApprovalStatus {
  approved
  pending
  denied
}

enum AuditObjectType {
  change
  incident
  access
  policy
  execution
  approval
}

enum AuditResult {
  success
  blocked
  escalated
  denied
}

enum RecommendationClass {
  required_now
  recommended
  optional_optimization
  out_of_scope
}

enum BlastRadiusType {
  service
  database
  api
  queue
  job
  monitoring
  integration
}

enum UserRole {
  operator
  engineer
  it_support
  approver
  access_approver
  admin
}

// ─── Models ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole
  team         String
  managerId    String?  @map("manager_id")
  systemsOwned String[] @default([]) @map("systems_owned")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  manager   User?  @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[] @relation("UserManager")

  @@index([managerId])
  @@map("users")
}

model Change {
  id                String         @id @default(cuid())
  ticketId          String         @unique @map("ticket_id")
  title             String
  description       String
  owner             String
  ownerTeam         String         @map("owner_team")
  service           String
  environment       String
  riskLevel         RiskLevel      @map("risk_level")
  status            ChangeStatus
  approvalState     ApprovalState  @map("approval_state")
  policyDecision    PolicyDecision @map("policy_decision")
  linkedPRs              String[]       @map("linked_prs")
  ciStatus               CIStatus       @map("ci_status")
  maintenanceWindow      String?        @map("maintenance_window")
  maintenanceWindowStart DateTime?      @map("maintenance_window_start")
  maintenanceWindowEnd   DateTime?      @map("maintenance_window_end")
  rollbackPlan           Boolean        @map("rollback_plan")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  blastRadius     BlastRadiusItem[]
  recommendations Recommendation[]
  auditEvents     AuditEvent[]     @relation("ChangeAuditEvents")

  @@index([status])
  @@index([riskLevel])
  @@index([service])
  @@map("changes")
}

model BlastRadiusItem {
  id          String          @id @default(cuid())
  changeId    String          @map("change_id")
  name        String
  type        BlastRadiusType
  reason      String
  confidence  ConfidenceLevel
  criticality RiskLevel
  ownerTeam   String          @map("owner_team")
  details     String

  change Change @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@index([changeId])
  @@map("blast_radius_items")
}

model Recommendation {
  id                String              @id @default(cuid())
  changeId          String              @map("change_id")
  title             String
  reason            String
  evidence          String
  classification    RecommendationClass
  expectedBenefit   String              @map("expected_benefit")
  requiredApprovals String[]            @map("required_approvals")
  executableNow     Boolean             @map("executable_now")
  draftOnly         Boolean             @map("draft_only")

  change Change @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@index([changeId])
  @@map("recommendations")
}

model Incident {
  id                String           @id @default(cuid())
  incidentId        String           @unique @map("incident_id")
  title             String
  description       String
  requester         String
  affectedService   String           @map("affected_service")
  severity          IncidentSeverity
  status            IncidentStatus
  assignmentGroup   String           @map("assignment_group")
  relatedCI         String[]         @map("related_ci")
  relatedChanges    String[]         @map("related_changes")
  likelyIssueType   String           @map("likely_issue_type")
  rootCauseCategory String           @map("root_cause_category")
  recommendedFix    String           @map("recommended_fix")
  kbArticles        String[]         @map("kb_articles")
  isRecurring       Boolean          @map("is_recurring")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([severity])
  @@index([status])
  @@map("incidents")
}

model AccessRequest {
  id                      String              @id @default(cuid())
  requestId               String              @unique @map("request_id")
  requester               String
  requesterEmail          String              @map("requester_email")
  requestedSystem         String              @map("requested_system")
  requestedRole           String              @map("requested_role")
  justification           String
  manager                 String
  systemOwner             String              @map("system_owner")
  status                  AccessRequestStatus
  riskLevel               RiskLevel           @map("risk_level")
  policyDecision          PolicyDecision      @map("policy_decision")
  entitlementCheck        EntitlementCheck    @map("entitlement_check")
  autoGrantAllowed        Boolean             @map("auto_grant_allowed")
  managerApprovalRequired Boolean             @map("manager_approval_required")
  ownerApprovalRequired   Boolean             @map("owner_approval_required")
  managerApproval         ApprovalState       @map("manager_approval")
  ownerApproval           ApprovalState       @map("owner_approval")
  reason                  String
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@index([riskLevel])
  @@map("access_requests")
}

model Approval {
  id                   String         @id @default(cuid())
  type                 ApprovalType
  title                String
  requester            String
  impactedSystem       String         @map("impacted_system")
  riskLevel            RiskLevel      @map("risk_level")
  reason               String
  recommendedAction    String         @map("recommended_action")
  status               ApprovalStatus
  condition            String?
  conditionResolved    Boolean        @default(false) @map("condition_resolved")
  conditionResolvedAt  DateTime?      @map("condition_resolved_at")
  conditionResolvedBy  String?        @map("condition_resolved_by")
  createdAt            DateTime       @default(now()) @map("created_at")
  linkedObjectId       String         @map("linked_object_id")
  whyYouAreRequired    String?        @map("why_you_are_required")
  /// B2: optimistic locking. Every mutation must specify the expected current
  /// version; concurrent writers see a version mismatch and one loses cleanly
  /// instead of silently overwriting. Bumped on every state-changing update.
  version              Int            @default(0)

  coApprovals    CoApproval[]
  decisionImpact DecisionImpact?

  @@index([status])
  @@index([type])
  @@map("approvals")
}

model CoApproval {
  id         String           @id @default(cuid())
  approvalId String           @map("approval_id")
  role       String
  name       String
  status     CoApprovalStatus
  decidedAt  DateTime?        @map("decided_at")

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@map("co_approvals")
}

model DecisionImpact {
  id         String @id @default(cuid())
  approvalId String @unique @map("approval_id")
  approve    String
  deny       String
  escalate   String

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@map("decision_impacts")
}

model AuditEvent {
  id          String          @id @default(cuid())
  timestamp   DateTime        @default(now())
  /// B4: monotonic per-process sequence — auto-incrementing autoincrement provides
  /// deterministic ordering even when two events share the same millisecond
  /// timestamp. Use this (NOT timestamp) for "show events in order" queries.
  sequence    Int             @default(autoincrement())
  actor       String
  action      String
  objectType  AuditObjectType @map("object_type")
  objectId    String          @map("object_id")
  objectTitle String          @map("object_title")
  policyRule  String?         @map("policy_rule")
  result      AuditResult
  details     String

  // Optional direct relation to change (for change-specific audit events)
  changeId String? @map("change_id")
  change   Change? @relation("ChangeAuditEvents", fields: [changeId], references: [id], onDelete: SetNull)

  // Optional back-relation to AgentInvocation (when this audit row was caused by an agentic skill)
  agentInvocation AgentInvocation?

  @@index([objectType, objectId])
  @@index([timestamp(sort: Desc)])
  @@index([sequence(sort: Desc)])
  @@index([actor])
  @@map("audit_events")
}

model PolicyRule {
  id          String         @id @default(cuid())
  name        String         @unique
  description String
  bundle      String
  decision    PolicyDecision
  scope       String
  appliesTo   String[]       @map("applies_to")
  isActive    Boolean        @map("is_active")

  @@map("policy_rules")
}

// ─── Phase 0 additions ──────────────────────────────────

enum AgentInvocationStatus {
  success
  validation_failed
  error
}

enum AgentSkillKind {
  agentic
  deterministic
  integration
}

/// Provenance row for every agentic skill invocation. Links optionally to the
/// audit_event the invocation produced. Deterministic skills do NOT write here.
model AgentInvocation {
  id           String                @id @default(cuid())
  auditEventId String?               @unique @map("audit_event_id")
  skill        String                // e.g. "triage_change", "route_approvers"
  kind         AgentSkillKind        @default(agentic)
  model        String                // e.g. "claude-sonnet-4-20250514"
  promptHash   String                @map("prompt_hash")
  tokensIn     Int                   @map("tokens_in")
  tokensOut    Int                   @map("tokens_out")
  cached       Boolean               @default(false)
  latencyMs    Int                   @map("latency_ms")
  confidence   Float?
  status       AgentInvocationStatus
  errorMessage String?               @map("error_message")
  actor        String                // user.name or "system" for autonomous skills
  createdAt    DateTime              @default(now()) @map("created_at")

  auditEvent AuditEvent? @relation(fields: [auditEventId], references: [id], onDelete: SetNull)

  @@index([skill])
  @@index([createdAt(sort: Desc)])
  @@index([actor])
  @@map("agent_invocations")
}

/// Org- or service-scoped freeze window. Execution gate consults active windows
/// at policy_check time and blocks if the candidate change overlaps.
model FreezeWindow {
  id          String   @id @default(cuid())
  name        String
  description String
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  appliesTo   String[] @default([]) @map("applies_to") // services or environments; empty = global
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([startsAt])
  @@index([endsAt])
  @@index([isActive])
  @@map("freeze_windows")
}

// ─── Cross-session chat memory ──────────────────────────

enum ChatMessageRole {
  user
  assistant
}

/// Stored chat messages. Cross-session memory: chat route can load this user's
/// recent messages on each request and inject into the system prompt so Claude
/// remembers past conversations.
///
/// Privacy: this table is per-user (userId). Chat does NOT see other users'
/// private chats. System-wide audit_events and agent_invocations remain the
/// shared source of "what's been done."
model ChatMessage {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  /// Stable session identifier. Frontend can pass the same sessionId across
  /// a single conversation; multiple sessions per user are normal.
  sessionId String          @map("session_id")
  role      ChatMessageRole
  content   String
  /// Optional context fragment the message was sent with (pagePath, entityType, etc.).
  /// Stored as JSON string for forward compatibility without schema churn.
  contextJson String?       @map("context_json")
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ─── B1: Idempotency keys ───────────────────────────────

/// Per-(user, key) record of one mutation request. Action endpoints write
/// here BEFORE performing the side effect; subsequent requests with the same
/// (user, key) return the cached response instead of replaying the action.
///
/// Why per-user: an idempotency key is meaningless across users (different
/// payloads, different auth). Scoping by userId prevents one user's keys from
/// shadowing another's.
model IdempotencyRecord {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  /// Client-supplied key from the Idempotency-Key header. Stable per intended action.
  key          String
  /// Hash of method + path + body — guards against the same key being reused
  /// for a different action (which would be a client bug).
  requestHash  String   @map("request_hash")
  /// HTTP status code of the recorded response.
  statusCode   Int      @map("status_code")
  /// Cached response body (JSON). Bounded; large responses may be truncated.
  responseBody String   @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, key])
  @@index([createdAt(sort: Desc)])
  @@map("idempotency_records")
}

// ─── Integrations (Phase 2 foundation) ─────────────────────

/// External system Sentinel can connect to. Each row represents one
/// configured connection — credentials are AES-GCM encrypted; nothing
/// sensitive is ever returned to clients.
enum IntegrationType {
  github
  slack
  linear
  sentry
  pagerduty
}

enum IntegrationStatus {
  /// Wizard started but credentials not yet submitted.
  pending
  /// Credentials saved and a recent ping succeeded.
  connected
  /// Last ping failed (rate limit, revoked token, network).
  degraded
  /// User-initiated disconnect; row kept for audit.
  disconnected
}

/// One configured connection to an external system.
///
/// Secrets handling (HARD RULES):
///   - `credentialsCiphertext` is AES-256-GCM, key from ENCRYPTION_KEY env.
///   - Plaintext credentials are never stored, never logged, never sent to
///     the client. Settings APIs return scope + status only.
///   - Decrypt is on-use, in-process; result never crosses the network.
model Integration {
  id               String              @id @default(cuid())
  type             IntegrationType
  /// Display name — `"GitHub: razeenmeera"` or `"Slack: sentinel-ws"`. Surfaced in Settings.
  displayName      String              @map("display_name")
  status           IntegrationStatus   @default(pending)
  /// Encrypted credentials blob (base64). Format: `<iv>.<authTag>.<ciphertext>`.
  /// Never exposed via any API. Nullable so a `pending` row can exist before
  /// the user enters a token.
  credentialsCiphertext String?        @map("credentials_ciphertext")
  /// Non-secret scope/config — repos[], channels[], etc. Safe to expose.
  config           Json                @default("{}")
  /// Outbound webhook secret if Sentinel registered one with the provider.
  /// Encrypted same as credentials; only needed for signature verification.
  webhookSecretCiphertext String?      @map("webhook_secret_ciphertext")
  /// Last time we successfully pinged the provider. Drives the green/yellow
  /// dot in the Settings card.
  lastCheckedAt    DateTime?           @map("last_checked_at")
  /// Stringified provider error from the last failed ping. Bounded to 1KB.
  lastError        String?             @map("last_error")
  createdBy        String              @map("created_by")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  webhookEvents    WebhookEvent[]
  externalRefs     ExternalRef[]

  /// One active integration per type for now. Future: multi-account per type
  /// will require a tuple key (type, accountId). Drop this constraint then.
  @@unique([type])
  @@index([status])
  @@map("integrations")
}

/// Every inbound webhook is recorded: dedup, replay, audit. The body is
/// stored raw so we can reprocess if our handler had a bug. Old rows are
/// pruned by a scheduled job; defaults to 90 days.
model WebhookEvent {
  id            String       @id @default(cuid())
  integrationId String       @map("integration_id")
  integration   Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// Provider-supplied event id (GitHub X-GitHub-Delivery, Slack event id, etc.).
  /// Combined with integrationId is the dedup key — replays from the provider
  /// hit the unique index and are no-op'd.
  providerEventId String     @map("provider_event_id")
  /// Provider-supplied event type (pull_request, push, message, etc.).
  eventType     String       @map("event_type")
  /// Raw request body, as bytes from the wire. Used for HMAC re-verification
  /// and reprocessing. Bounded to 256KB at the handler.
  rawBody       String       @map("raw_body")
  /// Outcome of our handler: 'processed' | 'skipped' | 'failed'.
  result        String
  /// Error message when result='failed'. Truncated.
  errorMessage  String?      @map("error_message")
  receivedAt    DateTime     @default(now()) @map("received_at")

  @@unique([integrationId, providerEventId])
  @@index([receivedAt(sort: Desc)])
  @@index([integrationId, eventType])
  @@map("webhook_events")
}

/// Cross-system id mapping. Lets the UI render "this Change is also
/// GitHub PR #42 + Linear ENG-101" and lets agents look the other direction
/// ("did GitHub PR #42 originate from a Sentinel Change?").
model ExternalRef {
  id              String       @id @default(cuid())
  integrationId   String       @map("integration_id")
  integration     Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// Sentinel object pointer.
  sentinelType    AuditObjectType @map("sentinel_type")
  sentinelId      String       @map("sentinel_id")
  /// Foreign system pointer. e.g. ("github", "PR", "https://github.com/x/y/pull/42").
  externalKind    String       @map("external_kind")
  externalId      String       @map("external_id")
  externalUrl     String?      @map("external_url")
  /// Optional metadata blob (PR title, ticket status snapshot, etc.).
  meta            Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([integrationId, externalKind, externalId])
  @@index([sentinelType, sentinelId])
  @@map("external_refs")
}

/// First-run admin onboarding. Single row keyed by `singleton: true` — if
/// this row exists and `onboardingComplete=true`, the setup wizard is
/// skipped. Otherwise `/setup` redirect catches every route until done.
model SetupState {
  id                  String   @id @default(cuid())
  singleton           Boolean  @unique @default(true)
  onboardingComplete  Boolean  @default(false) @map("onboarding_complete")
  /// Step names already done: ["env_check", "encryption_key_generated", "first_admin", ...].
  completedSteps      String[] @default([]) @map("completed_steps")
  firstAdminUserId    String?  @map("first_admin_user_id")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("setup_state")
}
